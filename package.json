{
  "name": "trovio-web",
  "version": "0.1.0",
  "private": true,
  "description": "Trovio – cổng định hướng đại học: tìm trường, chọn ngành, trắc nghiệm RIASEC. Next.js + Tailwind CSS, kiến trúc phân lớp.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "next build && TROVIO_DEMO=true next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate-pg.ts",
    "db:status": "tsx scripts/migrate-pg.ts --status",
    "admissions:programs": "tsx scripts/crawl-admissions.ts --resume",
    "admissions:export": "tsx scripts/export-tong-hop.ts",
    "admissions:publish": "tsx scripts/publish-catalog.ts",
    "admissions:transform": "tsx scripts/transform-admissions.ts",
    "admissions:import": "tsx scripts/import-admissions.ts",
    "admissions:validate": "tsx scripts/validate-admissions.ts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^18.0.7",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
