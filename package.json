{
  "name": "trovio-web",
  "version": "0.1.0",
  "private": true,
  "description": "Trovio – cổng định hướng đại học: tìm trường, chọn ngành, trắc nghiệm RIASEC. Next.js + Tailwind CSS, kiến trúc phân lớp.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "demo": "next build && TROVIO_DEMO=true next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx database/scripts/migrate-pg.ts",
    "db:status": "tsx database/scripts/migrate-pg.ts --status",
    "admissions:export": "tsx database/scripts/export-tong-hop.ts",
    "admissions:publish": "tsx database/scripts/publish-catalog.ts",
    "db:audit": "tsx database/scripts/audit.ts",
    "db:test": "node --conditions=react-server --import tsx --test database/tests/*.test.ts",
    "db:verify": "tsx database/scripts/verify-migrations.ts",
    "db:check": "tsx database/scripts/check-pg.ts",
    "db:typecheck": "tsc --noEmit -p database/tsconfig.json",
    "admissions:parse": "tsx database/scripts/parse-all-ts247.ts",
    "db:smoke": "node --conditions=react-server --import tsx database/scripts/smoke.ts",
    "db:verify:news": "node --conditions=react-server --import tsx database/scripts/verify-news.ts",
    "db:smoke:news": "node --import tsx database/scripts/smoke-news-http.ts",
    "db:verify:materials": "node --conditions=react-server --import tsx database/scripts/verify-materials.ts",
    "db:smoke:materials": "node --import tsx database/scripts/smoke-materials-http.ts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "exceljs": "^4.4.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.7",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
