# Chuỗi bí mật để ký cookie phiên đăng nhập, link đặt lại mật khẩu, state OAuth (bắt buộc đổi khi deploy)
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Địa chỉ gốc của web (dùng để tạo redirect URI cho Google). Local: http://localhost:3000
APP_URL=http://localhost:3001

# PostgreSQL is the only runtime data store. The app fails fast when this is missing or invalid.
DATABASE_URL=postgresql://user:password@host:5432/trovio
# (Tùy chọn) Thời gian chờ kết nối DB (ms), mặc định 15000ms (cần thiết cho serverless như Neon cold start)
# PG_CONNECT_TIMEOUT_MS=15000

# Đăng nhập Google (OAuth 2.0 Client ID loại "Web application" trong Google Cloud Console)
# Authorized redirect URI cần khai báo: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gửi email thật qua Resend. Nếu bỏ trống, môi trường phát triển chỉ in email ra terminal.
# MAIL_FROM phải là địa chỉ thuộc tên miền đã xác minh trong Resend, VD: Trovio <hello@trovio.vn>
RESEND_API_KEY=
MAIL_FROM=

# JSON cũ nằm trong database/local, chỉ lưu trữ lịch sử; PostgreSQL là runtime duy nhất.

# Chỉ bật một số tiện ích trình bày giao diện; không tạo dữ liệu và không bỏ qua xác thực.
# TROVIO_DEMO=false

# Email được cấp quyền quản trị dữ liệu (/quan-tri), phân tách bằng dấu phẩy
# ADMIN_EMAILS=ban@gmail.com

# (Tuỳ chọn, mặc định TẮT) Cho chatbot diễn đạt lại câu trả lời bằng mô hình ngôn ngữ.
# Mô hình chỉ viết lại dữ kiện đã truy xuất; câu có con số lạ / link / lỗi → dùng câu trả lời gốc.
# ANTHROPIC_MODEL: xem tên model hiện hành tại https://docs.claude.com/en/docs/about-claude/models
# CHATBOT_LLM=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Bí mật cho tác vụ gửi email nhắc hạn hằng ngày: bộ lập lịch gọi GET /api/cron/reminders
# với header "Authorization: Bearer <CRON_SECRET>". Để trống = tắt (route trả 503). Xem README › Email nhắc hạn.
# CRON_SECRET=

# Cổng thanh toán VNPay (ủng hộ dự án). Lấy TMN code + Hash secret từ email đăng ký sandbox tại
# https://sandbox.vnpayment.vn/devreg/ (môi trường thật: hợp đồng với VNPay). Thiếu 2 biến này → nút ủng hộ báo "tạm ngưng".
# Khai báo IPN URL với VNPay: {APP_URL}/api/donations/vnpay-ipn (phải truy cập được từ internet, localhost không nhận IPN).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=  (mặc định {APP_URL}/api/donations/vnpay-return)

# Email hỗ trợ công khai (để trống để dùng email demo)
NEXT_PUBLIC_SUPPORT_EMAIL=
